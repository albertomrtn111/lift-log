NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_API_VER=v1beta
GEMINI_RETRY_BASE_MS=700

# Public base URL used to build form links sent to athletes.
# Production: https://nexttrain.ascenttech.cloud
# Local dev:  http://localhost:3000
NEXT_PUBLIC_APP_URL=

# n8n Webhooks
N8N_ONBOARDING_WEBHOOK_URL=
N8N_INVITE_WEBHOOK_URL=
N8N_REVIEW_WEBHOOK_URL=
N8N_BASIC_AUTH_USER=
N8N_BASIC_AUTH_PASS=

# Cloudflare R2 (fotos). Ver docs/almacenamiento-r2.md
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Bucket público (fotos de perfil) y su URL pública (mejor un dominio propio que r2.dev)
R2_BUCKET=
R2_PUBLIC_URL=
# Bucket SIN acceso público (check-ins y chat). Si falta, esas fotos se guardan en Supabase.
R2_PRIVATE_BUCKET=
# proxy (por defecto: el servidor entrega las fotos privadas) o redirect (URL firmada de 5 min)
R2_PRIVATE_DELIVERY=
